# Copier ce fichier en .env.local et remplir les valeurs.
# .env.local n'est JAMAIS commité (voir .gitignore).

# Resend — envoi des e-mails du formulaire de contact (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=giuseppinarui@gmail.com
# Adresse expéditrice : doit appartenir à un domaine vérifié dans Resend.
# Tant que le domaine n'est pas vérifié, utiliser onboarding@resend.dev
CONTACT_FROM_EMAIL=onboarding@resend.dev

# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=https://www.giuseppinarui.ch
